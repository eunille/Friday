{
  "expo": {
    "name": "Friday",
    "slug": "offline-ai",
    "owner": "dajackal",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "offline-ai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "android": {
      "package": "com.eunille.offlineai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#16181D"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#16181D",
          "imageWidth": 140
        }
      ],
      "expo-status-bar",
      "react-native-blob-util",
      "@kesha-antonov/react-native-background-downloader",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Friday transcribes your voice notes on this device. Nothing is uploaded.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Friday reads a nutrition label from a photo you choose. The image is processed on this device and never uploaded.",
          "cameraPermission": "Friday reads a nutrition label you photograph. The image is processed on this device and never uploaded."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "338b5ab7-7686-4ee9-836e-a799fb5d4c43"
      }
    }
  }
}
