{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "uniwind-env.d.ts"],
  "exclude": [
    "src/lib/formats.check.ts",
    "src/lib/nutrition.check.ts",
    "src/lib/budget.check.ts"
  ]
}
